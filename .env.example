# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (docker-compose sets this for the app container).
DATABASE_URL=postgres://crm:change-me@localhost:5432/crm
POSTGRES_PASSWORD=change-me

# Where uploaded statements and KYC files are kept (a mounted volume in Docker).
STORAGE_DIR=./storage

# --- Backups (the `backup` service runs nightly at 01:30) ---------------------
# Encrypts every backup file. Store this passphrase somewhere safe OFF the server:
# without it the backups can't be restored.
BACKUP_PASSPHRASE=
# Off-site copy with rclone (Google Drive, OneDrive, S3, another server over SFTP…).
# Run `docker run --rm -it -v ./rclone:/config/rclone rclone/rclone config` once, then set e.g.
# RCLONE_REMOTE=gdrive:switchlink-crm-backups
RCLONE_REMOTE=
BACKUP_KEEP_DAYS=30
# Optional: a webhook (Slack, Teams, Google Chat, ntfy.sh) that's told when a backup fails.
ALERT_WEBHOOK_URL=

# --- Monitoring ----------------------------------------------------------------
# Lets an uptime monitor read the detailed /api/health checks (at least 16 random
# characters, sent as "Authorization: Bearer <token>"). Admins see them when signed in.
HEALTH_TOKEN=

# --- Optional virus scanning of KYC uploads (see docker-compose.yml) ------------
CLAMAV_HOST=

# Public address of the CRM, e.g. https://crm.switchlinkafrica.com
APP_URL=http://localhost:3000

# Address lookup. "nominatim" (free, OpenStreetMap), "google" (paid, needs key) or "off".
GEOCODER=nominatim
# Nominatim's usage policy asks for a contact email in the User-Agent.
GEOCODER_CONTACT_EMAIL=it@switchlinkafrica.com
GOOGLE_MAPS_API_KEY=

# Set to "true" only behind HTTPS (Caddy does this in production).
SECURE_COOKIES=false

# Public domain name for HTTPS (Caddy), e.g. crm.switchlinkafrica.com
CRM_DOMAIN=
