{
  "name": "switchlink-crm",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "author": "Anyonaz NewTech",
  "license": "UNLICENSED",
  "description": "Proprietary CRM built by Anyonaz NewTech for Switchlink Africa. Self-hosted: Next.js + PostgreSQL, no third-party backend.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "user:create-admin": "tsx scripts/create-admin.ts",
    "import:corporates": "tsx scripts/import-corporates.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/db/*.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.4",
    "leaflet": "1.9.4",
    "lucide-react": "0.451.0",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.4",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
